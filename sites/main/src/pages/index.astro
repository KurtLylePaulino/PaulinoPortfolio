---
import BaseLayout from "@portfolio/ui/components/BaseLayout.astro";
import SiteNav from "@portfolio/ui/components/SiteNav.astro";
import SiteFooter from "@portfolio/ui/components/SiteFooter.astro";
import HeroSection from "../components/HeroSection.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Credentials from "../components/Credentials.astro";
import WorldsGrid from "../components/WorldsGrid.astro";
import AboutContact from "../components/AboutContact.astro";
---

<BaseLayout title="Kurt Lyle Paulino" description="Developer. Machine learning, tools, and games.">
  <SiteNav current="home" />
  <main>
    <!-- The hero sits outside the container so its atmosphere runs full bleed
         and the nav appears to float over it. Everything after it is contained. -->
    <HeroSection />
    <div class="page">
      <SelectedWork />
      <Credentials />
      <WorldsGrid />
      <AboutContact />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .page {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .page {
      gap: var(--space-7);
    }
  }
</style>
