---
/**
 * The work index: a dense archival register, not a card grid.
 *
 * Filtering is CSS only. A flat radio group sits as direct siblings of the
 * row list under one wrapper, because the `~` sibling combinator only
 * reaches elements sharing the same parent. The radios stay in the layout
 * flow (clipped, not `display: none`) so keyboard and screen-reader users
 * keep them; the visible chip is a <label> styled to look like a control,
 * with its own focus ring since the input itself is invisible.
 *
 * Chip and per-row CSS selectors are generated from `domainsInUse()`, never
 * a literal domain list, so a new domain needs no change here.
 */
import BaseLayout from "@portfolio/ui/components/BaseLayout.astro";
import SiteNav from "@portfolio/ui/components/SiteNav.astro";
import SiteFooter from "@portfolio/ui/components/SiteFooter.astro";
import SectionHeading from "@portfolio/ui/components/SectionHeading.astro";
import Reveal from "@portfolio/ui/components/Reveal.astro";
import WorkRow from "../../components/WorkRow.astro";
import { domainMeta, domainsInUse, projects } from "@portfolio/content";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/+$/, "")}/${path.replace(/^\/+/, "")}`;

const domains = domainsInUse();

const filters = [
  { id: "all", label: "All", accent: "var(--accent)" },
  ...domains.map((domain) => ({
    id: domain,
    label: domainMeta(domain).label,
    accent: domainMeta(domain).accent,
  })),
];

// Year descending, then title ascending within a year. Year strings may be
// a range ("2024-2026"); the leading four digits are what order the list.
const sorted = [...projects].sort((a, b) => {
  const yearA = Number.parseInt(a.year, 10);
  const yearB = Number.parseInt(b.year, 10);
  return yearA !== yearB ? yearB - yearA : a.title.localeCompare(b.title);
});

// Each domain filter hides every row not tagged for it, and reveals the
// empty-state row only when the list truly holds no such row. Both rules
// are generated by mapping over the data, never written out by hand.
//
// it), and a build test counts that exact double-quoted substring to verify
// every row is tagged. Single-quoting the CSS side keeps this stylesheet's
// selector text from being double-counted as if it were another row.
const filterCss = domains
  .map((domain) => {
    const id = `filter-${domain}`;
    return [
      `#${id}:checked ~ .work-index__list .row:not([data-domain='${domain}']) { display: none; }`,
      `#${id}:checked ~ .work-index__list:not(:has(.row[data-domain='${domain}'])) .work-index__empty { display: flex; }`,
    ].join("\n");
  })
  .join("\n");
---

<BaseLayout
  title="Work | Kurt Lyle Paulino"
  description={`${projects.length} projects across ${domains.length} domains.`}
>
  <SiteNav current="work" />
  <main>
    <div class="page">
      <Reveal>
        <section class="work-index">
          <SectionHeading level={1} text="Work" size="large" />
          <p class="work-index__count">
            {`${projects.length} projects across ${domains.length} domains.`}
          </p>

          <div class="work-index__filters" role="radiogroup" aria-label="Filter by domain">
            {
              filters.map((filter, i) => (
                <>
                  <input
                    type="radio"
                    name="domain-filter"
                    id={`filter-${filter.id}`}
                    class="work-index__radio"
                    checked={i === 0}
                  />
                  <label
                    class="chip"
                    for={`filter-${filter.id}`}
                    style={`--chip-accent: ${filter.accent};`}
                  >
                    {filter.label}
                  </label>
                </>
              ))
            }

            <div class="work-index__list">
              {sorted.map((project) => <WorkRow project={project} href={withBase(`work/${project.id}`)} />)}
              <p class="work-index__empty">No projects in this domain yet.</p>
            </div>
          </div>
        </section>
      </Reveal>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<Fragment set:html={`<style>${filterCss}</style>`} />

<style>
  .work-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .work-index__count {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    color: var(--ink-mid);
  }

  .work-index__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  /* Visually hidden but still focusable and in the tab order. `display:
     none` and `visibility: hidden` both remove a control from keyboard
     reach; this clip pattern does not. */
  .work-index__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    line-height: 1.4;
    padding: 0.35rem 0.7rem;
    color: var(--ink-mid);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: transparent;
    transition:
      color 200ms var(--ease),
      border-color 200ms var(--ease),
      background-color 200ms var(--ease);
  }

  .chip:hover {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--chip-accent) 45%, var(--line));
  }

  /* The checked radio's own following label. Adjacent-sibling, since the
     label is written immediately after its input in the markup. */
  .work-index__radio:checked + .chip {
    color: var(--ink);
    border-color: var(--chip-accent);
    background: color-mix(in srgb, var(--chip-accent) 14%, transparent);
  }

  /* The input itself is invisible, so its focus ring has to land on the
     label instead, or keyboard users get no feedback at all. */
  .work-index__radio:focus-visible + .chip {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .work-index__list {
    display: flex;
    flex-direction: column;
    flex: 1 0 100%;
    border-top: 1px solid var(--line);
  }

  .work-index__empty {
    display: none;
    padding: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--step-0);
    color: var(--ink-low);
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
  }
</style>
