---
import Reveal from "@portfolio/ui/components/Reveal.astro";

const facts = [
  { value: "BSCS", label: "De La Salle Lipa, game development track" },
  { value: "3", label: "thesis awards: Best Thesis, Best Paper, Best Presenter" },
  { value: "4", label: "languages shipped: C#, Python, JavaScript, TypeScript" },
];
---

<Reveal>
  <!-- A full bleed band on the raised surface. The page otherwise sits on one
       plane from top to bottom, so this is the break that gives it pacing, and
       it separates the two card sections either side of it. It is also the one
       place where the accent carries structural weight rather than trim. -->
  <section class="credentials">
    <div class="credentials__inner">
      {
        facts.map((fact) => (
          <div class="fact">
            <p class="fact__value">{fact.value}</p>
            <p class="fact__label">{fact.label}</p>
          </div>
        ))
      }
    </div>
  </section>
</Reveal>

<style>
  .credentials {
    background: var(--raised);
    border-block: 1px solid var(--line);
    padding-block: var(--space-6);
  }

  .credentials__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-5);
    border-left: 1px solid var(--line);
  }

  .fact:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .fact__value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .fact__label {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-body);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-mid);
  }

  @media (max-width: 767px) {
    .credentials {
      padding-block: var(--space-5);
    }

    .credentials__inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .fact {
      padding-left: 0;
      padding-top: var(--space-4);
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .fact:first-child {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
