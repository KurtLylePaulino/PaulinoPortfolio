---
import Reveal from "@portfolio/ui/components/Reveal.astro";

const facts = [
  { value: "BSCS", label: "De La Salle Lipa, game development track" },
  { value: "3", label: "thesis awards: Best Thesis, Best Paper, Best Presenter" },
  { value: "4", label: "languages shipped: C#, Python, JavaScript, TypeScript" },
];
---

<Reveal>
  <section class="credentials">
    {
      facts.map((fact) => (
        <div class="fact">
          <p class="fact__value">{fact.value}</p>
          <p class="fact__label">{fact.label}</p>
        </div>
      ))
    }
  </section>
</Reveal>

<style>
  .credentials {
    display: flex;
    align-items: stretch;
  }

  .fact {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0 var(--space-5);
    border-left: 1px solid var(--line);
  }

  .fact:first-child {
    padding-left: 0;
    border-left: none;
  }

  .fact:last-child {
    padding-right: 0;
  }

  .fact__value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .fact__label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 400;
    line-height: 1.4;
    color: var(--ink-mid);
  }

  @media (max-width: 767px) {
    .credentials {
      flex-direction: column;
    }

    .fact {
      padding: var(--space-4) 0;
      border-left: none;
      border-top: 1px solid var(--line);
    }

    .fact:first-child {
      padding-top: 0;
      border-top: none;
    }

    .fact:last-child {
      padding-bottom: 0;
    }
  }
</style>
