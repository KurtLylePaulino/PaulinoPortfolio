---
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/+$/, "")}/${path.replace(/^\/+/, "")}`;
---

<section class="hero">
  <div class="hero__inner">
    <p class="hero__eyebrow">Developer</p>
    <h1 class="hero__headline">I build machine learning, tools, and games.</h1>
    <p class="hero__subtext">
      Computer Science, De La Salle Lipa. A melanoma classifier at 90% accuracy, an award
      winning Unity thesis, shipped web apps.
    </p>
    <div class="hero__links">
      <a class="hero__link hero__link--primary" href={withBase("work")}>See the work</a>
      <a class="hero__link hero__link--secondary" href={withBase("resume.pdf")}>Resume</a>
    </div>
  </div>
</section>

<style>
  /* Full bleed atmospheric field. Type sits inside the light, not beside an
     image in a column. The atmosphere is CSS only for now; a generated warm
     backplate drops into .hero::before later without changing this structure. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: min(88svh, 820px);
    padding-block: var(--space-7) var(--space-6);
  }

  /* Layer 1: a distant warm light source, off centre to the right, plus a
     cooler ambient haze so the warmth reads as light rather than as a tint. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        42% 46% at 72% 34%,
        color-mix(in srgb, var(--accent) 22%, transparent),
        transparent 70%
      ),
      radial-gradient(
        70% 60% at 84% 22%,
        color-mix(in srgb, var(--ink-mid) 9%, transparent),
        transparent 72%
      ),
      radial-gradient(
        90% 70% at 20% 90%,
        color-mix(in srgb, var(--raised) 90%, transparent),
        transparent 60%
      );
  }

  /* Layer 2: vignette, and a fade into the page ground so the hero dissolves
     into the section beneath it instead of ending on a hard edge. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(120% 90% at 50% 40%, transparent 40%, var(--ground) 100%),
      linear-gradient(to bottom, transparent 62%, var(--ground) 100%);
  }

  .hero__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero__headline {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: var(--step-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--ink);
    text-wrap: balance;
  }

  .hero__subtext {
    margin: var(--space-2) 0 0;
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.6;
    color: var(--ink-mid);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      transform 200ms var(--ease),
      background-color 200ms var(--ease),
      border-color 200ms var(--ease),
      box-shadow 200ms var(--ease);
  }

  .hero__link--primary {
    background: var(--accent);
    color: var(--ground);
    border: 1px solid var(--accent);
  }

  .hero__link--secondary {
    color: var(--ink);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--raised) 70%, transparent);
  }

  .hero__link:hover {
    transform: translateY(-2px);
  }

  .hero__link--primary:hover {
    box-shadow: 0 12px 30px -12px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .hero__link--secondary:hover {
    border-color: var(--accent);
  }

  .hero__link:active {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__link:hover,
    .hero__link:active {
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding-block: var(--space-6) var(--space-5);
    }

    .hero__headline {
      max-width: none;
    }
  }
</style>
