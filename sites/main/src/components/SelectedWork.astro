---
import Reveal from "@portfolio/ui/components/Reveal.astro";
import SectionHeading from "@portfolio/ui/components/SectionHeading.astro";
import { featuredProjects, type Project } from "@portfolio/content";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/+$/, "")}/${path.replace(/^\/+/, "")}`;

const ABSOLUTE_HREF_PATTERN = /^https?:\/\//;
/** A link's href may be absolute (external) or site-relative (internal). */
const resolveHref = (href: string) => (ABSOLUTE_HREF_PATTERN.test(href) ? href : withBase(href));

// Do not assume featuredProjects has a fixed length: the first entry is the
// wide feature row, everything else fills the grid beneath it.
const [feature, ...remainder] = featuredProjects;
const gridColumns = Math.min(remainder.length, 2);

const primaryLink = (project: Project) =>
  project.links.find((link) => link.kind === "primary") ?? project.links[0];
---

<Reveal>
  <section class="selected-work">
    <SectionHeading text="Selected work" size="large" />

    {
      feature && (
        <article class="feature">
          <div class="feature__media">
            {feature.media ? (
              <img src={withBase(feature.media)} alt={feature.tagline} loading="lazy" />
            ) : (
              <div class="feature__media-fallback" aria-hidden="true" />
            )}
          </div>
          <div class="feature__body">
            <h3 class="feature__title">{feature.title}</h3>
            {feature.award && <p class="feature__award">{feature.award}</p>}
            <p class="feature__blurb">{feature.blurb}</p>
            <ul class="chips">
              {feature.stack.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
            {primaryLink(feature) && (
              <a
                class="feature__link"
                href={resolveHref(primaryLink(feature)!.href)}
                {...ABSOLUTE_HREF_PATTERN.test(primaryLink(feature)!.href)
                  ? { target: "_blank", rel: "noopener" }
                  : {}}
              >
                {primaryLink(feature)!.label}
              </a>
            )}
          </div>
        </article>
      )
    }

    {
      remainder.length > 0 && (
        <div class="grid" style={`grid-template-columns: repeat(${gridColumns}, 1fr);`}>
          {remainder.map((project) => (
            <article class="cell">
              {project.media && (
                <div class="cell__media">
                  <img src={withBase(project.media)} alt={project.tagline} loading="lazy" />
                </div>
              )}
              <h3 class="cell__title">{project.title}</h3>
              <p class="cell__year">{project.year}</p>
              <p class="cell__blurb">{project.blurb}</p>
              <ul class="chips">
                {project.stack.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      )
    }

    <a class="all-work" href={withBase("work")}>All work</a>
  </section>
</Reveal>

<style>
  .selected-work {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }


  /* Media sits ABOVE or BESIDE the copy on a raised surface here. The worlds
     grid overlays copy ON TOP of its images, so the two stay distinct. */
  .feature,
  .cell {
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      transform 400ms var(--ease),
      border-color 400ms var(--ease),
      box-shadow 400ms var(--ease);
  }

  .feature:hover,
  .cell:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: 0 18px 44px -24px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }

  .feature__media,
  .cell__media {
    position: relative;
    overflow: hidden;
    background: var(--ground);
  }

  /* Project captures are raw UI screenshots and run far brighter and more
     saturated than the palette. Damping them keeps the page one system
     instead of a dark page with a bright rectangle stapled to it. */
  .feature__media img,
  .cell__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.72) brightness(0.68) contrast(0.96);
    transform: scale(1.01);
    transition:
      transform 900ms var(--ease),
      filter 500ms var(--ease);
  }

  .feature:hover .feature__media img,
  .cell:hover .cell__media img {
    transform: scale(1.05);
    filter: saturate(0.92) brightness(0.82) contrast(1);
  }

  /* A scrim so the capture reads as part of the surface, not pasted onto it. */
  .feature__media::after,
  .cell__media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to right,
      transparent 55%,
      color-mix(in srgb, var(--raised) 70%, transparent) 100%
    );
  }

  .cell__media::after {
    background: linear-gradient(
      to bottom,
      transparent 55%,
      color-mix(in srgb, var(--raised) 80%, transparent) 100%
    );
  }

  .feature__media img {
    aspect-ratio: 16 / 10;
  }

  .cell__media img {
    aspect-ratio: 16 / 10;
  }

  .feature__media-fallback {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--ground);
  }

  .feature__body,
  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feature__body {
    justify-content: center;
    padding: var(--space-5);
  }

  .cell {
    padding: 0;
  }

  .cell > :not(.cell__media) {
    margin-inline: var(--space-4);
  }

  .cell > :first-child:not(.cell__media) {
    margin-top: var(--space-4);
  }

  .cell > :last-child {
    margin-bottom: var(--space-4);
  }

  .cell__title,
  .feature__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
    text-wrap: balance;
  }

  .feature__title {
    font-size: var(--step-2);
  }

  .cell__title {
    font-size: var(--step-1);
    margin-top: var(--space-3);
  }

  .feature__award {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    line-height: 1.4;
    color: var(--accent);
  }

  .cell__year {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    line-height: 1.4;
    color: var(--ink-low);
    font-variant-numeric: tabular-nums;
  }

  .feature__blurb,
  .cell__blurb {
    margin: 0;
    max-width: 52ch;
    font-family: var(--font-body);
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-mid);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.4;
    letter-spacing: 0.02em;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-low);
  }

  /* The flagship project's primary action. It was an underlined text link,
     which is a weak affordance for the most important link in the section. */
  .feature__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--ground) 60%, transparent);
    transition:
      border-color 200ms var(--ease),
      color 200ms var(--ease);
  }

  .feature__link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .grid {
    display: grid;
    gap: var(--space-3);
  }

  .all-work {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-mid);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.2rem;
    transition:
      color 200ms var(--ease),
      border-color 200ms var(--ease);
  }

  .all-work:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature,
    .cell,
    .feature__media img,
    .cell__media img {
      transition: none;
    }

    .feature:hover,
    .cell:hover {
      transform: none;
    }

    .feature:hover .feature__media img,
    .cell:hover .cell__media img {
      transform: scale(1.01);
    }
  }

  @media (max-width: 767px) {
    .feature {
      grid-template-columns: 1fr;
    }

    .feature__body {
      padding: var(--space-4);
    }

    .grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
