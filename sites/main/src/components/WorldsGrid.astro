---
import Reveal from "@portfolio/ui/components/Reveal.astro";
import SectionHeading from "@portfolio/ui/components/SectionHeading.astro";
import { artworks, projects, tracks, writings } from "@portfolio/content";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/+$/, "")}/${path.replace(/^\/+/, "")}`;

// Picked by id, not randomly, so every tile image is stable across builds.
const artById = (id: string) => {
  const artwork = artworks.find((a) => a.id === id);
  if (!artwork) throw new Error(`Worlds grid artwork "${id}" is missing from the artwork collection.`);
  return artwork;
};

const workImage = "img/projects/fightmap-generator.webp";
const artImage = artById("vivi-01");
const musicImage = artById("artwork-01");
const writingImage = artById("maps-01");

// Each tile is a single <a> wrapping the image, heading, and description, so
// a screen reader concatenates all of it into the link's accessible name.
// The image alt text below would be announced first, ahead of the world's
// own name, so the images are marked decorative (alt="") in the markup and
// the descriptions are kept here instead so the writing is not lost.
//   Work:    Screenshot of the Fightmap Generator rendering a top-down
//            dungeon tile map with glowing light sources.
//   Art:     A grinning character illustration with a glowing halo and a lab
//            coat, watched by disembodied eyes in the dark windows behind her.
//   Music:   A vast underground temple chamber with tiered stone platforms
//            and glowing blue light rising from a central altar.
//   Writing: An aerial view of a ruined, moss covered city built around a
//            dark crater, wrapped in teal fog.
const worlds = [
  {
    title: "Work",
    href: withBase("work"),
    accent: "var(--accent-work)",
    description: "Games, machine learning, tools, and the web.",
    count: `${projects.length} projects`,
    src: withBase(workImage),
  },
  {
    title: "Art",
    href: withBase("art"),
    accent: "var(--accent-art)",
    description: "Character studies, battle maps, and motion pieces.",
    count: `${artworks.length} pieces`,
    src: withBase(artImage.src),
  },
  {
    title: "Music",
    href: withBase("music"),
    accent: "var(--accent-music)",
    description: "Originals, a campaign score, and fan works.",
    count: `${tracks.length} tracks`,
    src: withBase(musicImage.src),
  },
  {
    title: "Writing",
    href: withBase("writing"),
    accent: "var(--accent-writing)",
    description: "Canrael: a dark fantasy world, seven years in.",
    count: `${writings.length} documents`,
    src: withBase(writingImage.src),
  },
];
---

<Reveal>
  <section class="worlds">
    <SectionHeading text="Four worlds" />
    <div class="worlds__grid">
      {
        worlds.map((world) => (
          <a class="tile" href={world.href} style={`--tile-accent: ${world.accent};`}>
            <img class="tile__image" src={world.src} alt="" loading="lazy" />
            <span class="tile__veil" aria-hidden="true" />
            <span class="tile__edge" aria-hidden="true" />
            <span class="tile__body">
              <h3 class="tile__title">{world.title}</h3>
              <p class="tile__description">{world.description}</p>
              <p class="tile__count">{world.count}</p>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Reveal>

<style>
  .worlds {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }


  /* Asymmetric bento rather than four equal cells: wide, narrow / narrow, wide.
     Four areas for four worlds, so a cell can never be left empty. */
  .worlds__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(15rem, 1fr);
    gap: var(--space-3);
  }

  .tile:nth-child(1) { grid-column: 1 / 3; }
  .tile:nth-child(2) { grid-column: 3 / 4; }
  .tile:nth-child(3) { grid-column: 1 / 2; }
  .tile:nth-child(4) { grid-column: 2 / 4; }

  /* Four stacked layers: image, veil, accent edge, body. The veil is what
     keeps the copy readable over artwork of any brightness. */
  .tile {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 400ms var(--ease),
      border-color 400ms var(--ease),
      box-shadow 400ms var(--ease);
  }

  .tile__image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.75) brightness(0.5);
    transform: scale(1.01);
    transition:
      transform 900ms var(--ease),
      filter 500ms var(--ease);
  }

  .tile__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      200deg,
      transparent 18%,
      color-mix(in srgb, var(--ground) 55%, transparent) 52%,
      color-mix(in srgb, var(--ground) 94%, transparent) 100%
    );
  }

  .tile__edge {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    box-shadow: inset 0 -3px 0 0 var(--tile-accent);
    opacity: 0.55;
    transition: opacity 400ms var(--ease);
  }

  .tile__body {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-4);
  }

  .tile__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
    text-wrap: balance;
  }

  .tile__description {
    margin: 0;
    max-width: 34ch;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 400;
    line-height: 1.55;
    color: var(--ink-mid);
  }

  .tile__count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.4;
    color: var(--tile-accent);
    font-variant-numeric: tabular-nums;
  }

  .tile:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--tile-accent) 55%, var(--line));
    box-shadow: 0 18px 44px -22px color-mix(in srgb, var(--tile-accent) 50%, transparent);
  }

  .tile:hover .tile__image {
    transform: scale(1.06);
    filter: saturate(0.95) brightness(0.62);
  }

  .tile:hover .tile__edge {
    opacity: 1;
  }

  .tile:active {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .tile__image,
    .tile__edge {
      transition: none;
    }

    .tile:hover,
    .tile:active {
      transform: none;
    }

    .tile:hover .tile__image {
      transform: scale(1.01);
    }
  }

  @media (max-width: 767px) {
    .worlds__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(13rem, auto);
    }

    .tile:nth-child(1),
    .tile:nth-child(2),
    .tile:nth-child(3),
    .tile:nth-child(4) {
      grid-column: 1 / -1;
    }
  }
</style>
