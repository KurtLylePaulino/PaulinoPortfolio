{
  "name": "paulino-portfolio",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "build": "npm run build -w sites/main && npm run build -w sites/technical"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
