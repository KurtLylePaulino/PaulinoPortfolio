---
interface Props {
  current?: string;
}
const { current } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/+$/, "")}/${path.replace(/^\/+/, "")}`;

const home = withBase("");
const links = [
  { slug: "work", label: "Work", href: withBase("work") },
  { slug: "art", label: "Art", href: withBase("art") },
  { slug: "music", label: "Music", href: withBase("music") },
  { slug: "writing", label: "Writing", href: withBase("writing") },
];
---

<nav class="site-nav" aria-label="Primary">
  <div class="site-nav__row">
    <a
      class="site-nav__brand"
      href={home}
      aria-current={current === "home" ? "page" : undefined}
    >
      Kurt Lyle Paulino
    </a>
    <ul class="site-nav__links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={current === link.slug ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--ground);
    border-bottom: 1px solid var(--line);
  }

  .site-nav__row {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
    max-height: 72px;
  }

  .site-nav__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__links li {
    white-space: nowrap;
  }

  .site-nav__links a {
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--ink-mid);
    text-decoration: none;
  }

  .site-nav__links a[aria-current="page"] {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .site-nav__row {
      flex-direction: column;
      align-items: flex-start;
      max-height: none;
      min-height: 0;
      padding-block: var(--space-3);
      gap: var(--space-2);
    }

    .site-nav__links {
      width: 100%;
      gap: var(--space-3);
    }
  }
</style>
