---
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/+$/, "")}/${path.replace(/^\/+/, "")}`;

const year = new Date().getFullYear();
const links = [
  { label: "Work", href: withBase("work") },
  { label: "Art", href: withBase("art") },
  { label: "Music", href: withBase("music") },
  { label: "Writing", href: withBase("writing") },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__name">Kurt Lyle Paulino</p>
    <nav class="site-footer__nav" aria-label="Footer">
      {
        links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>
    <p class="site-footer__year">{year}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    background: var(--raised);
    border-top: 1px solid var(--line);
  }

  .site-footer__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-5) var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4);
  }

  .site-footer__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-left: auto;
  }

  .site-footer__nav a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mid);
    text-decoration: none;
    transition: color 200ms var(--ease);
  }

  .site-footer__nav a:hover {
    color: var(--accent);
  }

  .site-footer__year {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-low);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    .site-footer__nav {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
